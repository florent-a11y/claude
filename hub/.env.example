# Display name of the platform (shown in the sidebar, page titles and emails).
NEXT_PUBLIC_APP_NAME=Hub
# Your company name (shown to clients in the portal).
NEXT_PUBLIC_ORG_NAME="ILA Global Consulting"

# Where the SQLite database and uploaded files live. Mount a persistent volume here in production.
DATA_DIR=./data

# Set to "true" when served over HTTPS (recommended in production) so cookies are marked Secure.
COOKIE_SECURE=false

# First administrator, created by `npm run seed` if no users exist yet.
SEED_ADMIN_NAME="Florent"
SEED_ADMIN_EMAIL=florent@ilaglobalconsulting.com
SEED_ADMIN_PASSWORD=change-me-now
