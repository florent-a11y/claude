# Public site
NEXT_PUBLIC_SITE_URL=https://www.allindonesia-arrivalcard.com
NEXT_PUBLIC_COMPANY_NAME="Your Company Limited"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Airwallex (Hong Kong entity). Create an API key in Airwallex > Developer > API keys.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
# "demo" or "prod"
AIRWALLEX_ENV=demo

# Supabase (project region: Singapore recommended)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ops console (HTTP basic auth)
ADMIN_USER=ops
ADMIN_PASSWORD=change-me-now

# Cron/secret for /api/news/refresh
CRON_SECRET=change-me-too

# Optional: Claude API key for English news summaries
ANTHROPIC_API_KEY=

# Optional: transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Arrival Card Assist <no-reply@example.com>"

# Ops alerts: who receives the "new paid order" email (comma-separated allowed)
OPS_EMAIL=ops@example.com

# Optional: one-way sync of orders into a Google Sheet (service account JSON, share the sheet with its client_email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
