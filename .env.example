# Public site
NEXT_PUBLIC_SITE_URL=https://allindonesia-arrivalcard.com
# Legal identity (defaults in lib/config.ts; override only if the company changes)
# NEXT_PUBLIC_COMPANY_NAME="Bulan Juli Limited"
# NEXT_PUBLIC_COMPANY_REG="Company Registration No. 76938968 · Business Registration No. 76938968-000"
# NEXT_PUBLIC_COMPANY_ADDRESS="Unit 909, Prosperity Millennia Plaza, 663 King's Road, Quarry Bay, Hong Kong"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Airwallex (Hong Kong entity). Create an API key in Airwallex > Developer > API keys.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
# "demo" or "prod"
AIRWALLEX_ENV=demo

# Supabase (project region: Singapore recommended)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ops console (HTTP basic auth)
ADMIN_USER=ops
ADMIN_PASSWORD=change-me-now

# Cron/secret for /api/news/refresh
CRON_SECRET=change-me-too

# Optional: Claude API key for English news summaries
ANTHROPIC_API_KEY=

# Optional: transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Arrival Card Assist <no-reply@example.com>"

# Ops alerts: who receives the "new paid order" email (comma-separated allowed)
OPS_EMAIL=ops@example.com

# Optional: one-way sync of orders into a Google Sheet (service account JSON, share the sheet with its client_email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Tracking (optional; nothing loads while these are empty). See docs/tracking.md.
# GA4 Admin → Data streams → your web stream → Measurement ID (G-XXXXXXXXXX). Also used by Google Ads via the GA4 conversion import.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4 Admin → Data streams → your web stream → Measurement Protocol API secrets → Create. Server-side purchase events.
GA_API_SECRET=
# Meta Events Manager → Data sources → your pixel → Settings → Pixel ID (numeric).
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Events Manager → Settings → Conversions API → Generate access token. Server-side Purchase events.
META_CAPI_ACCESS_TOKEN=
# Optional: Meta Events Manager → Test events → the TESTxxxxx code; events then show in that tab only. Leave empty in production.
META_CAPI_TEST_EVENT_CODE=
