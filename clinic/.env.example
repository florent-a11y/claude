# Copy to .env.local for local work; set the same names in Vercel > Project > Settings > Environment Variables.

# ---- Identity (everything here is shown on the public site) ----
NEXT_PUBLIC_BRAND_NAME=Pulih
NEXT_PUBLIC_SITE_URL=http://localhost:3200
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
# WhatsApp number in international format, digits only. Empty hides every WhatsApp button.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
# Lounge address and Google Maps link (empty: "address sent with your booking confirmation").
NEXT_PUBLIC_CLINIC_ADDRESS=
NEXT_PUBLIC_CLINIC_MAPS_URL=
# Legal entity that takes the orders, shown in the footer and legal pages.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_REG=
# Licensed facility that dispenses prescription items, and its licence number (shown in the footer once set).
NEXT_PUBLIC_DISPENSER_NAME=
NEXT_PUBLIC_DISPENSER_LICENCE=

# ---- Console sign-ins (HTTP basic auth at /admin) ----
# ops: orders, payments, delivery. Does not see health questionnaires.
ADMIN_USER=ops
ADMIN_PASSWORD=
# doctor: sees questionnaires, approves or declines prescription items.
DOCTOR_USER=doctor
DOCTOR_PASSWORD=

# ---- Database (Supabase, Singapore region). Run supabase/schema.sql first. ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments. A method without its keys is hidden in production. ----
# Xendit: QRIS, virtual accounts, e-wallets, Indonesian cards.
XENDIT_SECRET_KEY=
# Xendit > Settings > Webhooks > "Verification token". Webhook URL: <site>/api/webhooks/xendit (Invoices paid).
XENDIT_CALLBACK_TOKEN=
# Airwallex: international cards. Webhook URL: <site>/api/webhooks/airwallex (payment_intent.succeeded).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
# "demo" or "prod"
AIRWALLEX_ENV=demo
AIRWALLEX_CURRENCY=USD
# Rupiah per one unit of AIRWALLEX_CURRENCY, used to convert rupiah prices for the card charge. Keep it current.
IDR_PER_USD=
# Manual bank transfer (shown to the customer with the order number as reference).
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# "off" removes "pay on delivery or at the lounge".
PAY_ON_DELIVERY=on

# ---- Email (optional, Resend). Without it nothing is emailed; the console's WhatsApp button still works. ----
RESEND_API_KEY=
EMAIL_FROM="Pulih <orders@example.com>"
EMAIL_REPLY_TO=
# Who receives "new order", "doctor review needed" and "transfer to check" alerts (comma-separated).
OPS_EMAIL=
