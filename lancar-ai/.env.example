# Public address of the site, without a trailing slash. Used for canonical links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# --- Contact channels (shown on the site) ---------------------------------------------------------------------
# WhatsApp business number in international format, digits only (62 = Indonesia). Example: 6281234567890
# While this is empty, every "Book a free call" button leads to the contact form instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public email address. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=
# Registered company name for the footer and the privacy notice (for example "PT Lancar Solusi Digital").
NEXT_PUBLIC_LEGAL_NAME=

# --- Live AI demo (/demo) -------------------------------------------------------------------------------------
# Anthropic API key from https://console.anthropic.com. Without it the demo page shows a recorded example.
# Set a monthly spend limit for this key in the Anthropic Console: that is the hard cap on demo cost.
ANTHROPIC_API_KEY=

# --- Where enquiries go (contact form and quiz) ---------------------------------------------------------------
# Database: create a Supabase project (Singapore region), run supabase/schema.sql, then paste these two values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Email notification for each new enquiry, sent through Resend (https://resend.com).
RESEND_API_KEY=
# Sender (must be on a domain verified in Resend) and recipients (comma-separated).
EMAIL_FROM="Lancar AI <website@example.com>"
LEADS_EMAIL=
