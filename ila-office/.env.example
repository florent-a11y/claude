# ILA Office
# Session cookie signing secret (required in production, 32+ random characters).
SESSION_SECRET=

# Supabase (optional). Without it the app stores everything in ./data/*.json (development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where the file backend writes (default ./data).
# ILA_DATA_DIR=

# Seed script: first administrator (only used when no user exists yet).
SEED_ADMIN_EMAIL=florent@ilaglobalconsulting.com
SEED_ADMIN_NAME=Florent Delente
SEED_ADMIN_PASSWORD=change-me-now-please

# Email (Resend): needed for the "Send to client" button on invoices. Without it the app offers a mailto: link + PDF.
RESEND_API_KEY=
EMAIL_FROM="PT ILA Global Consulting <invoices@ilaglobalconsulting.com>"
# Optional: where client replies go, and a copy of every invoice email (comma-separated).
EMAIL_REPLY_TO=florent@ilaglobalconsulting.com
EMAIL_BCC=

# AI visibility (app/visibility): one API key per assistant to track. An assistant without a key is skipped.
# Claude's key is also used to rate tone, suggest prompts and draft articles.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Optional: the model asked on each assistant (defaults: claude-opus-5-5, gpt-5.1, gemini-2.5-flash, sonar).
# VISIBILITY_CLAUDE_MODEL=
# VISIBILITY_OPENAI_MODEL=
# VISIBILITY_GEMINI_MODEL=
# VISIBILITY_PERPLEXITY_MODEL=
